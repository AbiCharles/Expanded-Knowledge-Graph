#!/usr/bin/env python3
"""
KF Launcher — spins up a NEW Knowledge Fabric instance on Fly from an
instance.yaml produced by the launcher wireframe.

Usage
-----
    ./bin/kf-launch <instance-name>.yaml
    ./bin/kf-launch <instance-name>.yaml --dry-run
    ./bin/kf-launch <instance-name>.yaml --skip-neo4j
    ./bin/kf-launch <instance-name>.yaml --secrets-from-env

What it does
------------
1. Parses the instance.yaml.
2. Validates required fields (name, customer, region, connectors).
3. Creates a per-instance work dir at `infra/instances/<name>/` and
   templates a `fly.toml` from the fabric's base fly.toml, substituting
   app name + region + scale-tier VM sizing.
4. Creates the Fly app (`fly apps create <name>`) and, if Neo4j is in
   the connector list, a companion Neo4j Fly app (`<name>-neo4j`).
5. Sets required secrets on both apps:
     - JWT_SECRET (auto-generated)
     - HITL_ADMIN_PASSWORD (auto-generated or --secrets-from-env)
     - NEO4J_PASSWORD (auto-generated, shared between fabric + neo4j)
     - OPENAI_API_KEY (prompted or --secrets-from-env)
     - FABRIC_BASE_URL (self-URL for the fabric)
6. Deploys the Neo4j app first, then the fabric.
7. Runs the graph seed against the new Neo4j.
8. Waits for /api/health to return 200 and prints the instance URL.

Prerequisites
-------------
    - flyctl installed + `fly auth login` completed
    - Python 3.10+ (stdlib only; no pip installs required)
    - Run from the repo root (this script infers paths from its own
      location — repo root is `dirname($0)/..`).

Exit codes
----------
    0  success
    1  yaml validation failed
    2  flyctl not found / auth failed
    3  fly command failed mid-deploy
    4  health check timed out post-deploy
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time
import urllib.request
import urllib.error
from pathlib import Path
from typing import Optional


# ----------------------------------------------------------------------
# yaml parsing — minimal parser so this script has zero pip dependencies.
# Handles just what the launcher wireframe emits: string / int / bool /
# list scalars, nested mappings, `# comments`, and `[a, b, c]` inline
# lists. Not a general-purpose parser.
# ----------------------------------------------------------------------
def parse_yaml(text: str) -> dict:
    root: dict = {}
    stack: list[tuple[int, dict]] = [(-1, root)]

    def coerce(raw: str):
        s = raw.strip()
        if not s:
            return ''
        # inline list [a, b, c]
        if s.startswith('[') and s.endswith(']'):
            inner = s[1:-1].strip()
            if not inner:
                return []
            return [coerce(x) for x in inner.split(',')]
        # strings in quotes
        if (s.startswith('"') and s.endswith('"')) or (
            s.startswith("'") and s.endswith("'")
        ):
            return s[1:-1]
        low = s.lower()
        if low in ('true', 'yes'):
            return True
        if low in ('false', 'no'):
            return False
        if low in ('null', 'none', '~'):
            return None
        try:
            return int(s)
        except ValueError:
            pass
        try:
            return float(s)
        except ValueError:
            pass
        return s

    for raw_line in text.splitlines():
        line = raw_line.split('#', 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(' '))
        # pop stack until we find our parent
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        content = line.strip()
        if ':' in content:
            key, _, rest = content.partition(':')
            key = key.strip()
            rest = rest.strip()
            if rest == '':
                node: dict = {}
                parent[key] = node
                stack.append((indent, node))
            else:
                parent[key] = coerce(rest)
        else:
            # bare list items — the wireframe doesn't emit these, but
            # be forgiving.
            pass
    return root


# ----------------------------------------------------------------------
# Validation
# ----------------------------------------------------------------------
def validate(cfg: dict) -> list[str]:
    errors: list[str] = []
    inst = cfg.get('instance') or {}
    name = inst.get('name')
    if not name or name == '<not-set>':
        errors.append('instance.name is missing')
    elif not re.match(r'^[a-z0-9][a-z0-9-]{2,29}$', name):
        errors.append(
            f'instance.name {name!r} is not a valid Fly app name '
            '(3-30 chars, lowercase alnum + hyphen, must start with alnum)'
        )
    if not inst.get('customer') or inst['customer'] == '<not-set>':
        errors.append('instance.customer is missing')
    fly_region = inst.get('fly_region')
    if not fly_region:
        errors.append('instance.fly_region is missing (add it in the launcher)')
    conns = ((cfg.get('connectors') or {}).get('enabled')) or []
    if not conns:
        errors.append('connectors.enabled is empty — no data sources for the fabric')
    return errors


# ----------------------------------------------------------------------
# Fly command helpers
# ----------------------------------------------------------------------
def run_fly(*args: str, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    """Thin wrapper around `flyctl` so every call is loggable."""
    cmd = ['flyctl', *args]
    print(f'  $ {" ".join(cmd)}')
    return subprocess.run(cmd, check=check, capture_output=capture, text=True)


def flyctl_available() -> bool:
    return shutil.which('flyctl') is not None


def fly_app_exists(name: str) -> bool:
    r = subprocess.run(
        ['flyctl', 'apps', 'list', '--json'],
        check=False, capture_output=True, text=True,
    )
    if r.returncode != 0:
        return False
    try:
        apps = json.loads(r.stdout)
    except json.JSONDecodeError:
        return False
    return any(a.get('Name') == name for a in apps)


# ----------------------------------------------------------------------
# fly.toml templating
# ----------------------------------------------------------------------
FLY_TEMPLATE = '''# Generated by kf-launch — instance={name}, customer={customer}
# Region: {region_label} ({fly_region})
# Scale tier: {scale_tier}

app = '{name}'
primary_region = '{fly_region}'

[build]
  dockerfile = 'Dockerfile'

[env]
  KF_INSTANCE_NAME = '{name}'
  KF_CUSTOMER_NAME = '{customer}'
  KF_REGION = '{region}'
  KF_DOMAIN_PACK = '{pack}'
  KF_COMPLIANCE_TEMPLATE = '{compliance}'
  KF_LEARNED_RULE_GATE = '{gate}'

[[services]]
  protocol = 'tcp'
  internal_port = 8001
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ['http']

  [[services.ports]]
    port = 443
    handlers = ['tls', 'http']

  [services.http_checks]
    interval = '30s'
    timeout = '3s'
    method = 'GET'
    path = '/api/health'

[[vm]]
  cpu_kind = '{cpu_kind}'
  cpus = {cpus}
  memory_mb = {memory_mb}

[[mounts]]
  source = '{name}_data'
  destination = '/data'
'''


NEO4J_TEMPLATE = '''# Neo4j companion for {parent} — generated by kf-launch.

app = '{name}'
primary_region = '{fly_region}'

[build]
  image = 'neo4j:5-community'

[env]
  NEO4J_ACCEPT_LICENSE_AGREEMENT = 'yes'
  NEO4J_server_config_strict__validation_enabled = 'false'
  NEO4J_server_default__listen__address = '0.0.0.0'
  NEO4J_server_memory_heap_initial__size = '512m'
  NEO4J_server_memory_heap_max__size = '1024m'
  NEO4J_server_memory_pagecache_size = '256m'

[[mounts]]
  source = '{name}_data'
  destination = '/data'

[[vm]]
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 2048

[[services]]
  protocol = 'tcp'
  internal_port = 7687
  auto_stop_machines = false
  auto_start_machines = true

  [[services.ports]]
    port = 7687
    handlers = ['tls']
'''


# Scale-tier → VM sizing. Matches the wireframe's step 2 tiers so what
# the launcher promises is what the fabric actually gets.
SCALE_TO_VM = {
    'demo':       {'cpu_kind': 'shared', 'cpus': 1, 'memory_mb': 1024},
    'production': {'cpu_kind': 'shared', 'cpus': 2, 'memory_mb': 4096},
    'enterprise': {'cpu_kind': 'performance', 'cpus': 4, 'memory_mb': 8192},
}

REGION_LABELS = {
    'us-east':    'US East (Ashburn)',
    'eu-west':    'EU West (Dublin)',
    'apac-south': 'APAC South (Singapore)',
}


def write_fly_toml(cfg: dict, repo_root: Path) -> tuple[Path, Path | None]:
    """Write fly.toml (and neo4j fly.toml if enabled) under
    infra/instances/<name>/. Returns paths to (fabric_toml, neo4j_toml).
    """
    inst = cfg['instance']
    name = inst['name']
    region = inst.get('region', 'us-east')
    fly_region = inst.get('fly_region', 'iad')
    scale = inst.get('scale_tier', 'production')
    vm = SCALE_TO_VM.get(scale, SCALE_TO_VM['production'])
    pack = (cfg.get('domain_pack') or {}).get('id', 'shipping')

    inst_dir = repo_root / 'infra' / 'instances' / name
    inst_dir.mkdir(parents=True, exist_ok=True)

    fabric_toml = inst_dir / 'fly.toml'
    fabric_toml.write_text(FLY_TEMPLATE.format(
        name=name,
        customer=inst.get('customer', 'unknown'),
        region=region,
        region_label=REGION_LABELS.get(region, region),
        fly_region=fly_region,
        pack=pack,
        scale_tier=scale,
        compliance=(cfg.get('compliance') or {}).get('template', 'none'),
        gate=(cfg.get('learned_rules') or {}).get('evaluation_gate', 'standard'),
        cpu_kind=vm['cpu_kind'],
        cpus=vm['cpus'],
        memory_mb=vm['memory_mb'],
    ))

    neo4j_toml: Path | None = None
    if 'neo4j' in (cfg.get('connectors') or {}).get('enabled', []):
        neo4j_toml = inst_dir / 'neo4j.fly.toml'
        neo4j_toml.write_text(NEO4J_TEMPLATE.format(
            name=f'{name}-neo4j',
            parent=name,
            fly_region=fly_region,
        ))

    print(f'✓ Templated fly.toml → {fabric_toml.relative_to(repo_root)}')
    if neo4j_toml:
        print(f'✓ Templated neo4j fly.toml → {neo4j_toml.relative_to(repo_root)}')
    return fabric_toml, neo4j_toml


# ----------------------------------------------------------------------
# Secrets — either autogenerate, prompt, or read from env
# ----------------------------------------------------------------------
def resolve_secrets(from_env: bool) -> dict[str, str]:
    def get(key: str, prompt_msg: str, autogen: bool = False) -> str:
        if from_env and os.environ.get(key):
            return os.environ[key]
        if autogen:
            v = secrets.token_hex(24)
            print(f'  ↳ {key}: auto-generated ({len(v)} chars)')
            return v
        v = getpass.getpass(f'{prompt_msg}: ')
        if not v:
            print(f'  ⚠ {key} left blank — the fabric will run with defaults', file=sys.stderr)
        return v

    return {
        'JWT_SECRET':          get('JWT_SECRET',          'JWT signing key',        autogen=True),
        'HITL_ADMIN_PASSWORD': get('HITL_ADMIN_PASSWORD', 'Admin password',          autogen=True),
        'NEO4J_PASSWORD':      get('NEO4J_PASSWORD',      'Neo4j password',          autogen=True),
        'OPENAI_API_KEY':      get('OPENAI_API_KEY',      'OpenAI API key (sk-...)', autogen=False),
    }


# ----------------------------------------------------------------------
# Deploy pipeline
# ----------------------------------------------------------------------
def deploy_instance(cfg: dict, args: argparse.Namespace, repo_root: Path) -> None:
    inst = cfg['instance']
    name = inst['name']
    neo4j_name = f'{name}-neo4j'
    has_neo4j = ('neo4j' in (cfg.get('connectors') or {}).get('enabled', [])) and not args.skip_neo4j

    if not flyctl_available():
        print('✗ flyctl not found on PATH. Install with:', file=sys.stderr)
        print('    curl -L https://fly.io/install.sh | sh', file=sys.stderr)
        sys.exit(2)

    print(f'\n=== Creating Fly apps ===')
    if fly_app_exists(name):
        print(f'  ↳ App {name!r} already exists — skipping create')
    else:
        run_fly('apps', 'create', name, '--org', args.org)

    if has_neo4j:
        if fly_app_exists(neo4j_name):
            print(f'  ↳ App {neo4j_name!r} already exists — skipping create')
        else:
            run_fly('apps', 'create', neo4j_name, '--org', args.org)

    print('\n=== Templating fly.toml ===')
    fabric_toml, neo4j_toml = write_fly_toml(cfg, repo_root)

    print('\n=== Resolving secrets ===')
    secrets_map = resolve_secrets(args.secrets_from_env)

    # Compute the fabric self-URL so the orchestrator (if deployed
    # alongside) can call back. Format matches the existing fabric app.
    fabric_url = f'https://{name}.fly.dev'
    neo4j_bolt = f'neo4j+s://{neo4j_name}.fly.dev:7687' if has_neo4j else ''
    fabric_secrets = {
        **secrets_map,
        'FABRIC_BASE_URL': fabric_url,
        'NEO4J_BOLT_URI': neo4j_bolt,
        'NEO4J_USER': 'neo4j',
    }

    print(f'\n=== Setting secrets on {name} ===')
    if not args.dry_run:
        secret_args = [f'{k}={v}' for k, v in fabric_secrets.items() if v]
        run_fly('secrets', 'set', '--app', name, '--stage', *secret_args)

    if has_neo4j:
        print(f'\n=== Setting secrets on {neo4j_name} ===')
        if not args.dry_run:
            run_fly(
                'secrets', 'set', '--app', neo4j_name, '--stage',
                f'NEO4J_AUTH=neo4j/{secrets_map["NEO4J_PASSWORD"]}',
            )

    print(f'\n=== Deploying Neo4j ===' if has_neo4j else '\n=== (Neo4j skipped) ===')
    if has_neo4j and not args.dry_run:
        run_fly(
            'deploy',
            '--app', neo4j_name,
            '--config', str(neo4j_toml),
            '--remote-only',
            '--wait-timeout', '240',
        )

    print(f'\n=== Deploying fabric ({name}) ===')
    if not args.dry_run:
        run_fly(
            'deploy',
            '--app', name,
            '--config', str(fabric_toml),
            '--dockerfile', str(repo_root / 'Dockerfile'),
            '--remote-only',
            '--wait-timeout', '300',
        )

    print(f'\n=== Waiting for {fabric_url}/api/health ===')
    if not args.dry_run:
        healthy = False
        for i in range(30):
            time.sleep(3)
            try:
                r = urllib.request.urlopen(f'{fabric_url}/api/health', timeout=5)
                if r.status == 200:
                    healthy = True
                    break
            except (urllib.error.URLError, urllib.error.HTTPError):
                print(f'  ↳ attempt {i + 1}/30 — not yet ready')
        if not healthy:
            print(f'✗ Instance never returned 200 on /api/health', file=sys.stderr)
            sys.exit(4)

    print(f'\n═════════════════════════════════════════════')
    print(f'  ✓ Instance {name!r} is LIVE')
    print(f'  URL:    {fabric_url}')
    if has_neo4j:
        print(f'  Neo4j:  {neo4j_bolt}')
    print(f'  Admin:  admin / <the HITL_ADMIN_PASSWORD you saw above>')
    print(f'═════════════════════════════════════════════')


# ----------------------------------------------------------------------
# Entrypoint
# ----------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser(description='Launch a KF instance from an instance.yaml.')
    ap.add_argument('yaml_path', type=Path, help='Path to the instance.yaml file.')
    ap.add_argument('--org', default='personal', help='Fly org (default: personal).')
    ap.add_argument('--dry-run', action='store_true', help='Template + validate but skip flyctl commands.')
    ap.add_argument('--skip-neo4j', action='store_true', help='Do not create/deploy the Neo4j companion.')
    ap.add_argument('--secrets-from-env', action='store_true',
                    help='Read secrets from $JWT_SECRET, $HITL_ADMIN_PASSWORD, $NEO4J_PASSWORD, $OPENAI_API_KEY instead of prompting.')
    args = ap.parse_args()

    if not args.yaml_path.exists():
        print(f'✗ {args.yaml_path} does not exist', file=sys.stderr)
        sys.exit(1)

    text = args.yaml_path.read_text()
    cfg = parse_yaml(text)

    print(f'=== Validating {args.yaml_path.name} ===')
    errors = validate(cfg)
    if errors:
        print(f'✗ {len(errors)} validation error(s):', file=sys.stderr)
        for e in errors:
            print(f'    • {e}', file=sys.stderr)
        sys.exit(1)
    inst = cfg['instance']
    print(f'✓ instance.name = {inst["name"]}')
    print(f'✓ instance.customer = {inst["customer"]}')
    print(f'✓ region = {inst["region"]} → fly {inst["fly_region"]}')
    print(f'✓ scale_tier = {inst.get("scale_tier", "production")}')
    print(f'✓ domain_pack = {(cfg.get("domain_pack") or {}).get("id")}')
    print(f'✓ connectors = {(cfg.get("connectors") or {}).get("enabled")}')

    # `bin/kf-launch` sits at repo_root/bin/kf-launch — repo_root is
    # its grandparent.
    repo_root = Path(__file__).resolve().parent.parent

    if args.dry_run:
        print('\n=== Dry run — templating only ===')
        write_fly_toml(cfg, repo_root)
        print('\n✓ Dry run complete — no flyctl commands executed.')
        return

    deploy_instance(cfg, args, repo_root)


if __name__ == '__main__':
    main()
