# =============================================================================
# HITL Context Framework — environment configuration
# Copy to .env and fill in the values you need.
# =============================================================================

# REQUIRED. Server-side JWT signing secret. Backend refuses to start without
# a real value. Generate one once with:  openssl rand -hex 32
# To run the demo without setting one (local-only), export
#   HITL_ALLOW_DEFAULT_SECRET=1
JWT_SECRET=

# Which LLM backend to use. One of: openai | azure | fake
# `fake` returns canned responses (used by tests; lets you run the UI without credentials).
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# OpenAI (used when LLM_PROVIDER=openai)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Set this to whatever model your account has access to.
# Examples: gpt-4o, gpt-4o-mini, gpt-4-turbo, or any custom name your deployment exposes.
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Azure OpenAI (used when LLM_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# This is the *deployment name* you configured in the Azure portal — not a model id.
AZURE_OPENAI_DEPLOYMENT=
# Optional. Separate deployment for the embeddings model (e.g. text-embedding-3-small).
# Required only if you use vector-store data sources on Azure — without it, vector
# retrieval returns empty results while everything else still works.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
